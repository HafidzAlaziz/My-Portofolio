# Firebase Environment Variables - Copy this to .env and fill in your values
VITE_FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# Google Drive Environment Variables for Dynamic Certificates
VITE_GOOGLE_DRIVE_API_KEY=YOUR_GOOGLE_DRIVE_API_KEY
VITE_GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID
